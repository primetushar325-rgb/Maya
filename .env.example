# Local control plane
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DEMO_MODE=true

# Replace both before any shared or production deployment.
JWT_SECRET=local-only-change-this-to-a-random-secret-at-least-32-characters
CREDENTIAL_ENCRYPTION_KEY=local-only-encryption-key-change-before-deploying
DEMO_EMAIL=demo@mayastream.local
DEMO_PASSWORD=MayaDemo!2026
# First production admin only: set once, then rotate/remove after initial login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace Admin

# Leave DATABASE_URL and REDIS_URL empty for the in-memory UI preview.
DATABASE_URL=
REDIS_URL=

# Local file storage is convenient for development. Production should use S3.
STORAGE_DRIVER=local
DATA_DIR=./data
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=maya-streams
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# Google OAuth (optional until configured in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/youtube/callback

# Upload and worker limits
MAX_UPLOAD_BYTES=5368709120
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_CONCURRENCY=2
MAX_RECONNECT_ATTEMPTS=6
